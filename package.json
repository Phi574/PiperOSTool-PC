{
  "name": "piperos-tool-pc",
  "version": "3.3.2-beta",
  "description": "PiperOS View Remote desktop companion for Windows",
  "author": "Phi574",
  "main": "src/main/main.js",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "msi": "powershell -ExecutionPolicy Bypass -File scripts/build-msi.ps1",
    "test": "node --test"
  },
  "build": {
    "appId": "com.piper.os.tool.pc",
    "productName": "PiperOS Tool",
    "copyright": "Copyright (C) 2026 Phi574",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/piperos.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "afterPack": "scripts/brand-airplay-runtime.js",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ]
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
